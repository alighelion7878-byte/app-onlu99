{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app-onlu99",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4f2a897c-0989-4b2f-b051-2764f34ea819","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e01d785415df45f6ba29d6324149a25f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
